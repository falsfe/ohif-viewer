PORT=4001
NODE_ENV=development
# If auth-api runs on the same machine as MySQL, keep localhost.
# If auth-api runs on Windows while MySQL stays on the Ubuntu VM, replace 127.0.0.1
# with the VM IP, for example: 192.168.150.101.
DATABASE_URL="mysql://ohif_user:CHANGE_ME@127.0.0.1:3306/ohif_auth"
JWT_ACCESS_SECRET=replace-with-a-long-random-access-secret
JWT_REFRESH_SECRET=replace-with-a-long-random-refresh-secret
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d
COOKIE_DOMAIN=
